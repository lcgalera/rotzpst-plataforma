# Copie para .env e preencha. Nunca commitar .env.
# Nenhuma chave secreta é necessária até a Fase 3.

# Liga a frase "Pátria amada, Brasil." no carregamento (PLANO-DESIGN §1). Padrão: desligada. Implementação na Fase B.
FEATURE_FRASE_CARREGAMENTO=false

# Fase 1: banco. Em desenvolvimento, Postgres local; hospedagem definida no deploy.
DATABASE_URL=postgresql://rotzx:rotzx@localhost:5432/rotzx
# Banco descartável para testes de integração (é apagado a cada teste). Sem ele, esses testes são pulados.
DATABASE_URL_TEST=postgresql://rotzx:rotzx@localhost:5432/rotzx_test

# Fase 3: IA para notícias (modelo e limite a definir com o dono do projeto)
# ANTHROPIC_API_KEY=
# IA_LIMITE_MENSAL_USD=
